{
  "name": "2mqjs",
  "description": "A tiny performance-first architecture toolkit for framework-free web apps: lazy components, event ports, workers, tasks, and an off-main-thread store.",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/types-compat.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "default": "./dist/main.js",
      "types": "./dist/types-compat.d.ts"
    },
    "./ports": {
      "import": "./dist/ports.js",
      "default": "./dist/ports.js"
    },
    "./events": {
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./workers": {
      "import": "./dist/workers.js",
      "default": "./dist/workers.js"
    },
    "./components": {
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./tasks": {
      "import": "./dist/tasks.js",
      "default": "./dist/tasks.js"
    },
    "./store": {
      "import": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ports": [
        "dist/ports.d.ts"
      ],
      "events": [
        "dist/events.d.ts"
      ],
      "workers": [
        "dist/workers.d.ts"
      ],
      "components": [
        "dist/components.d.ts"
      ],
      "tasks": [
        "dist/tasks.d.ts"
      ],
      "store": [
        "dist/store.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && node scripts/postbuild.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:manual": "vite tests/manual --host 127.0.0.1 --port 4173 --strictPort",
    "dev": "tsc --watch",
    "check": "npm run release:check",
    "release:check": "npm run test && npm run build && npm run smoke:package && npm run pack:dry-run",
    "smoke:package": "node scripts/smoke-package.mjs",
    "pack:dry-run": "npm_config_cache=/tmp/2mqjs-npm-cache npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Poliklot/2mqjs"
  },
  "bugs": {
    "url": "https://github.com/Poliklot/2mqjs/issues"
  },
  "homepage": "https://github.com/Poliklot/2mqjs#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "web-performance",
    "vanilla-js",
    "typescript",
    "lazy-loading",
    "web-workers",
    "event-bus",
    "state-management",
    "frontend-architecture"
  ],
  "author": "Poliklot"
}
